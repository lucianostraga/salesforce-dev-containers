// One dev container per project. scripts/new-project.sh copies this folder and replaces __PROJECT__.
// Based on Anthropic's reference dev container (github.com/anthropics/claude-code/tree/main/.devcontainer).
// Every deviation from it is marked "CHANGE:".
{
  "name": "__PROJECT__",

  "build": {
    "dockerfile": "Dockerfile",
    "args": {
      "TZ": "${localEnv:TZ:America/Los_Angeles}",
      "CLAUDE_CODE_VERSION": "latest",
      // CHANGE: Salesforce CLI version ("latest" or a number). Rebuild Without Cache to update it.
      "SF_CLI_VERSION": "latest",
      "GIT_DELTA_VERSION": "0.20.1",
      "ZSH_IN_DOCKER_VERSION": "1.2.1"
    }
  },

  // CHANGE: a Docker network per project, so projects can't reach each other's ports.
  // Runs on your machine before the container starts.
  "initializeCommand": "docker network inspect __PROJECT__-net >/dev/null 2>&1 || docker network create __PROJECT__-net",

  "runArgs": [
    "--cap-add=NET_ADMIN",
    "--cap-add=NET_RAW",
    "--network=__PROJECT__-net"
  ],

  "customizations": {
    "vscode": {
      // CHANGE: only the Claude Code extension. Add the Salesforce extensions if you want them.
      "extensions": ["anthropic.claude-code"],
      "settings": {
        "terminal.integrated.defaultProfile.linux": "zsh",
        "terminal.integrated.profiles.linux": {
          "bash": { "path": "bash", "icon": "terminal-bash" },
          "zsh": { "path": "zsh" }
        }
      }
    }
  },

  "remoteUser": "node",

  "mounts": [
    // CHANGE: one named volume per project, mounted as the whole home folder. It holds the Claude login, memory,
    // history and MCP servers (~/.claude, ~/.claude.json) and the Salesforce orgs and Dev Hub (~/.sf, ~/.sfdx).
    // It survives rebuilds and can be backed up and moved (scripts/backup-home.sh).
    "source=__PROJECT__-home,target=/home/node,type=volume",
    // CHANGE: this folder is read-only inside the container, so the agent can't edit the allowed domains or the
    // firewall and open its own network.
    "source=${localWorkspaceFolder}/.devcontainer,target=/workspace/.devcontainer,type=bind,readonly"
  ],

  "containerEnv": {
    // CHANGE: --dns-result-order=ipv4first, so the browser callback of `sf org login web` reaches the CLI.
    "NODE_OPTIONS": "--max-old-space-size=4096 --dns-result-order=ipv4first",
    "CLAUDE_CONFIG_DIR": "/home/node/.claude",
    "POWERLEVEL9K_DISABLE_GITSTATUS": "true",
    // CHANGE: no Salesforce CLI telemetry (its host is not in the allowed list).
    "SF_DISABLE_TELEMETRY": "true"
  },

  "workspaceMount": "source=${localWorkspaceFolder},target=/workspace,type=bind,consistency=delegated",
  "workspaceFolder": "/workspace",

  "postStartCommand": "sudo /usr/local/bin/init-firewall.sh",
  "waitFor": "postStartCommand"
}
